# file (default): read a canonical release from $GRAPH_RELEASES_DIR/<GRAPH_RELEASE>
# neo4j: query Neo4j server-side (credentials never reach the browser)
GRAPH_BACKEND=file
GRAPH_RELEASE=fixture-sample
# directory holding release folders (default: ../../data/releases); real snapshots live outside git
# GRAPH_RELEASES_DIR=/path/to/releases
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
